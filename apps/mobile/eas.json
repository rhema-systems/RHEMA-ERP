{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "env": {
        "EXPO_PUBLIC_RHEMA_ENVIRONMENT": "TEST"
      }
    },
    "uat": {
      "distribution": "internal",
      "environment": "preview",
      "env": {
        "EXPO_PUBLIC_RHEMA_ENVIRONMENT": "UAT"
      }
    },
    "production": {
      "autoIncrement": true,
      "environment": "production",
      "env": {
        "EXPO_PUBLIC_RHEMA_ENVIRONMENT": "PRODUCTION"
      }
    }
  }
}
