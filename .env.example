# ERP System Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to source control

# Database Configuration
DATABASE_CONNECTION_STRING=Server=localhost\sql2017;Database=RhemaERPTDC;User Id=sa;Password=sa;MultipleActiveResultSets=true;TrustServerCertificate=true;

# Redis Configuration  
REDIS_CONNECTION_STRING=localhost:6379

# JWT Authentication
JWT_SECRET_KEY=your-256-bit-secret-key-here-minimum-32-characters-long
JWT_ISSUER=ErpSystem.Api
JWT_AUDIENCE=ErpSystem.Client
JWT_EXPIRY_HOURS=24

# External-Portal Authentication (candidate careers + consultant-client portals)
# REQUIRED — the API throws at startup if PortalSecretKey/PortalAudience/PortalUrl are missing.
# The portal secret MUST be different from JWT_SECRET_KEY and the portal audience MUST be different
# from JWT_AUDIENCE (external portal tokens are deliberately validated on a separate key + audience).
JWT_PORTAL_SECRET_KEY=your-DISTINCT-256-bit-portal-secret-key-minimum-32-characters-long
JWT_PORTAL_AUDIENCE=ErpSystem.Portal
# Absolute base URL of the external portal — used to build verification / reset / offer email links.
PORTAL_URL=https://portal.example.com

# Forwarded Headers (proxy/load-balancer) — needed for correct client IP in rate limiting & audit logs.
# SECURE DEFAULT: leave empty to trust NO proxy (X-Forwarded-* ignored). List your proxy IPs and/or
# CIDR networks (comma-separated is NOT supported here — set as a JSON array in appsettings, or as
# ForwardedHeaders__KnownNetworks__0=10.0.0.0/8 style indexed env vars) to enable it.
# FORWARDEDHEADERS__KNOWNNETWORKS__0=10.0.0.0/8
# FORWARDEDHEADERS__KNOWNPROXIES__0=10.0.0.5

# Security
ENCRYPTION_KEY=your-256-bit-encryption-key-here-minimum-32-characters-long

# CORS Settings (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,https://localhost:3000,http://localhost:3001,https://localhost:3001

# Application Settings
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=https://localhost:5001;http://localhost:5000

# Optional: reCAPTCHA Keys (leave empty if not using)
RECAPTCHA_SECRET_KEY=
HCAPTCHA_SECRET_KEY=

# File Storage (for cloud providers)
AZURE_STORAGE_CONNECTION_STRING=
AWS_ACCESS_KEY=
AWS_SECRET_KEY=

# Audit Logging Settings
AUDIT__ENABLED=true
AUDIT__ONLYAUDITABLEENTITIES=false
AUDIT__INCLUDESYSTEMCHANGES=false
AUDIT__MAXAUDITVALUELENGTH=4000

# Performance Optimization Settings
DATABASE_PERFORMANCE__ENABLEQUERYMONITORING=true
DATABASE_PERFORMANCE__SLOWQUERYTHRESHOLDMS=500
DATABASE_PERFORMANCE__MAXPOOLSIZE=100

# Caching Configuration  
CACHING__DEFAULTEXPIRY=00:15:00
CACHING__L1CACHESIZELIMITMB=100
CACHING__ENABLEL1CACHE=true
CACHING__ENABLEL2CACHE=true

# Response Caching Settings
RESPONSECACHING__ENABLED=true
RESPONSECACHING__MAXIMUMBODYSIZE=64
RESPONSECACHING__SIZELIMIT=100
RESPONSECACHING__DEFAULTCACHEDURATION=300

# Frontend Optimization Settings
FRONTENDOPTIMIZATION__ENABLEDNSPREFETCH=true
FRONTENDOPTIMIZATION__ENABLERESOURCEHINTS=true
FRONTENDOPTIMIZATION__ENABLETIMINGHEADERS=true
FRONTENDOPTIMIZATION__ENABLECOMPRESSION=true
FRONTENDOPTIMIZATION__ENABLELAZYLOADING=true

# Query Result Caching Settings
QUERYCACHING__ENABLEQUERYCACHING=true
QUERYCACHING__DEFAULTCACHEDURATIONSECONDS=300
QUERYCACHING__MAXROWSTOCACHE=1000
QUERYCACHING__CACHEEXPENSIVEQUERIESONLY=false
QUERYCACHING__EXPENSIVEQUERYTHRESHOLDMS=500
