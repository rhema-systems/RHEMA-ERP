@page "/sales/orders"
@attribute [Authorize]
@using Syncfusion.Blazor.Grids
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Calendars
@using Syncfusion.Blazor.Popups
@using Syncfusion.Blazor.Cards
@using GridFilterType = Syncfusion.Blazor.Grids.FilterType
@using GridSelectionMode = Syncfusion.Blazor.Grids.SelectionMode
@using GridSelectionType = Syncfusion.Blazor.Grids.SelectionType

<PageTitle>Sales Orders - ErpSystem</PageTitle>

<div class="sales-container">
    <!-- Header -->
    <div class="sales-header">
        <h1 class="page-title">Sales Orders</h1>
        <div class="header-actions">
            <SfButton IsPrimary="true" IconCss="e-icons e-plus" @onclick="OpenCreateOrderDialog">
                New Order
            </SfButton>
            <SfButton IsPrimary="false" IconCss="e-icons e-export" @onclick="ExportToExcel">
                Export
            </SfButton>
            <SfButton IsPrimary="false" IconCss="e-icons e-refresh" @onclick="RefreshData">
                Refresh
            </SfButton>
        </div>
    </div>

    <!-- Filter Section -->
    <SfCard class="filter-card">
        <CardContent>
            <div class="filter-row">
                <div class="filter-item">
                    <label>Date Range:</label>
                    <SfDateRangePicker TValue="DateTime[]" @bind-Value="dateRange" Format="dd/MM/yyyy" Width="200px">
                    </SfDateRangePicker>
                </div>
                <div class="filter-item">
                    <label>Status:</label>
                    <SfDropDownList TValue="string" TItem="StatusOption" DataSource="statusOptions" 
                                    @bind-Value="selectedStatus" Width="150px">
                        <DropDownListFieldSettings Value="Value" Text="Text"></DropDownListFieldSettings>
                    </SfDropDownList>
                </div>
                <div class="filter-item">
                    <label>Customer:</label>
                    <SfAutoComplete TValue="string" TItem="string" DataSource="customerNames" 
                                    @bind-Value="selectedCustomer" Width="200px" Placeholder="Search customer...">
                    </SfAutoComplete>
                </div>
                <div class="filter-item">
                    <SfButton IsPrimary="true" @onclick="ApplyFilters">Apply Filters</SfButton>
                    <SfButton IsPrimary="false" @onclick="ClearFilters">Clear</SfButton>
                </div>
            </div>
        </CardContent>
    </SfCard>

    <!-- Main Data Grid -->
    <SfCard class="grid-card">
        <CardContent>
            <SfGrid @ref="OrderGrid" DataSource="filteredOrders" AllowPaging="true" AllowSorting="true" 
                    AllowFiltering="true" AllowExcelExport="true" AllowGrouping="true" 
                    AllowSelection="true" Height="600px">
                <GridPageSettings PageSize="20"></GridPageSettings>
                <GridFilterSettings Type="GridFilterType.Excel"></GridFilterSettings>
                <GridSelectionSettings Mode="GridSelectionMode.Row" Type="GridSelectionType.Single"></GridSelectionSettings>
                <GridGroupSettings ShowDropArea="false"></GridGroupSettings>
                
                <GridColumns>
                    <GridColumn Field="@nameof(SalesOrder.OrderId)" HeaderText="Order ID" Width="120" IsPrimaryKey="true">
                        <Template>
                            @{
                                var order = (context as SalesOrder);
                                <a href="/sales/orders/@order.OrderId" class="order-link">@order.OrderId</a>
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(SalesOrder.CustomerName)" HeaderText="Customer" Width="180"></GridColumn>
                    <GridColumn Field="@nameof(SalesOrder.OrderDate)" HeaderText="Order Date" Width="140" Format="d" Type="ColumnType.DateTime"></GridColumn>
                    <GridColumn Field="@nameof(SalesOrder.TotalAmount)" HeaderText="Total Amount" Width="140" Format="C2" Type="ColumnType.Number"></GridColumn>
                    <GridColumn Field="@nameof(SalesOrder.Status)" HeaderText="Status" Width="120">
                        <Template>
                            @{
                                var order = (context as SalesOrder);
                                <span class="status-badge @(order.Status.ToLower().Replace(" ", "-"))">
                                    @order.Status
                                </span>
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn Field="@nameof(SalesOrder.SalesRepName)" HeaderText="Sales Rep" Width="150"></GridColumn>
                    <GridColumn Field="@nameof(SalesOrder.DeliveryDate)" HeaderText="Delivery Date" Width="140" Format="d" Type="ColumnType.DateTime"></GridColumn>
                    <GridColumn Field="@nameof(SalesOrder.Priority)" HeaderText="Priority" Width="100">
                        <Template>
                            @{
                                var order = (context as SalesOrder);
                                <span class="priority-badge @(order.Priority.ToLower())">
                                    @order.Priority
                                </span>
                            }
                        </Template>
                    </GridColumn>
                    <GridColumn HeaderText="Actions" Width="150">
                        <Template>
                            @{
                                var order = (context as SalesOrder);
                                <div class="action-buttons">
                                    <SfButton IconCss="e-icons e-edit" IsPrimary="false" CssClass="e-small" 
                                              @onclick="() => EditOrder(order.OrderId)"></SfButton>
                                    <SfButton IconCss="e-icons e-eye" IsPrimary="false" CssClass="e-small" 
                                              @onclick="() => ViewOrder(order.OrderId)"></SfButton>
                                    <SfButton IconCss="e-icons e-delete" IsPrimary="false" CssClass="e-small e-danger" 
                                              @onclick="() => DeleteOrder(order.OrderId)"></SfButton>
                                </div>
                            }
                        </Template>
                    </GridColumn>
                </GridColumns>
            </SfGrid>
        </CardContent>
    </SfCard>
</div>

<!-- Create/Edit Order Dialog -->
<SfDialog @bind-Visible="showOrderDialog" Width="800px" Height="600px" 
          Header="@(isEditMode ? "Edit Order" : "Create New Order")" IsModal="true">
    <DialogTemplates>
        <Content>
            <div class="order-form">
                <div class="form-row">
                    <div class="form-group">
                        <label>Customer:</label>
                        <SfDropDownList TValue="string" TItem="string" DataSource="customerNames" 
                                        @bind-Value="currentOrder.CustomerName" Width="100%">
                        </SfDropDownList>
                    </div>
                    <div class="form-group">
                        <label>Order Date:</label>
                        <SfDatePicker TValue="DateTime" @bind-Value="currentOrder.OrderDate" Width="100%">
                        </SfDatePicker>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Status:</label>
                        <SfDropDownList TValue="string" TItem="StatusOption" DataSource="statusOptions" 
                                        @bind-Value="currentOrder.Status" Width="100%">
                            <DropDownListFieldSettings Value="Value" Text="Text"></DropDownListFieldSettings>
                        </SfDropDownList>
                    </div>
                    <div class="form-group">
                        <label>Sales Representative:</label>
                        <SfDropDownList TValue="string" TItem="string" DataSource="salesReps" 
                                        @bind-Value="currentOrder.SalesRepName" Width="100%">
                        </SfDropDownList>
                    </div>
                </div>
                <div class="form-row">
                    <div class="form-group">
                        <label>Delivery Date:</label>
                        <SfDatePicker TValue="DateTime?" @bind-Value="currentOrder.DeliveryDate" Width="100%">
                        </SfDatePicker>
                    </div>
                    <div class="form-group">
                        <label>Priority:</label>
                        <SfDropDownList TValue="string" TItem="PriorityOption" DataSource="priorityOptions" 
                                        @bind-Value="currentOrder.Priority" Width="100%">
                            <DropDownListFieldSettings Value="Value" Text="Text"></DropDownListFieldSettings>
                        </SfDropDownList>
                    </div>
                </div>
                <div class="form-group">
                    <label>Notes:</label>
                    <SfTextBox Multiline="true" @bind-Value="currentOrder.Notes" Width="100%" RowCount="3">
                    </SfTextBox>
                </div>
            </div>
        </Content>
    </DialogTemplates>
    <DialogButtons>
        <DialogButton Content="Save" IsPrimary="true" OnClick="SaveOrder" />
        <DialogButton Content="Cancel" OnClick="CancelOrder" />
    </DialogButtons>
</SfDialog>

@code {
    private SfGrid<SalesOrder>? OrderGrid;
    private List<SalesOrder> orders = new();
    private List<SalesOrder> filteredOrders = new();
    private List<string> customerNames = new();
    private List<string> salesReps = new();
    
    // Filter properties
    private DateTime[]? dateRange = new DateTime[] { DateTime.Now.AddMonths(-1), DateTime.Now };
    private string selectedStatus = "All";
    private string selectedCustomer = string.Empty;
    
    // Dialog properties
    private bool showOrderDialog = false;
    private bool isEditMode = false;
    private SalesOrder currentOrder = new();
    
    // Dropdown options
    private List<StatusOption> statusOptions = new()
    {
        new() { Value = "All", Text = "All Statuses" },
        new() { Value = "Draft", Text = "Draft" },
        new() { Value = "Pending", Text = "Pending" },
        new() { Value = "Processing", Text = "Processing" },
        new() { Value = "Shipped", Text = "Shipped" },
        new() { Value = "Delivered", Text = "Delivered" },
        new() { Value = "Cancelled", Text = "Cancelled" }
    };
    
    private List<PriorityOption> priorityOptions = new()
    {
        new() { Value = "Low", Text = "Low" },
        new() { Value = "Medium", Text = "Medium" },
        new() { Value = "High", Text = "High" },
        new() { Value = "Urgent", Text = "Urgent" }
    };

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
        ApplyFilters();
    }

    private async Task LoadData()
    {
        // Simulate loading data from database
        await Task.Delay(100);
        
        // Sample customers
        customerNames = new List<string>
        {
            "Acme Corporation", "Tech Solutions Inc", "Global Industries Ltd", "Innovate Systems",
            "Future Technologies", "Digital Dynamics", "Smart Solutions", "Advanced Analytics",
            "Cloud First Corp", "Data Driven Inc"
        };
        
        // Sample sales reps
        salesReps = new List<string>
        {
            "John Smith", "Sarah Johnson", "Mike Wilson", "Emily Davis", "Chris Brown"
        };
        
        // Generate sample orders
        orders = GenerateSampleOrders();
    }

    private List<SalesOrder> GenerateSampleOrders()
    {
        var random = new Random();
        var sampleOrders = new List<SalesOrder>();
        var statuses = new[] { "Draft", "Pending", "Processing", "Shipped", "Delivered", "Cancelled" };
        var priorities = new[] { "Low", "Medium", "High", "Urgent" };
        
        for (int i = 1; i <= 100; i++)
        {
            var orderDate = DateTime.Now.AddDays(-random.Next(1, 90));
            sampleOrders.Add(new SalesOrder
            {
                OrderId = $"SO-{DateTime.Now.Year}-{i:D4}",
                CustomerName = customerNames[random.Next(customerNames.Count)],
                OrderDate = orderDate,
                TotalAmount = random.Next(500, 50000),
                Status = statuses[random.Next(statuses.Length)],
                SalesRepName = salesReps[random.Next(salesReps.Count)],
                DeliveryDate = orderDate.AddDays(random.Next(1, 30)),
                Priority = priorities[random.Next(priorities.Length)],
                Notes = $"Sample order notes for {i}"
            });
        }
        
        return sampleOrders.OrderByDescending(o => o.OrderDate).ToList();
    }

    private void ApplyFilters()
    {
        filteredOrders = orders.Where(order =>
        {
            // Date range filter
            if (dateRange != null && dateRange.Length == 2)
            {
                if (order.OrderDate < dateRange[0] || order.OrderDate > dateRange[1])
                    return false;
            }
            
            // Status filter
            if (selectedStatus != "All" && order.Status != selectedStatus)
                return false;
            
            // Customer filter
            if (!string.IsNullOrEmpty(selectedCustomer) && 
                !order.CustomerName.Contains(selectedCustomer, StringComparison.OrdinalIgnoreCase))
                return false;
            
            return true;
        }).ToList();
    }

    private void ClearFilters()
    {
        dateRange = new DateTime[] { DateTime.Now.AddMonths(-1), DateTime.Now };
        selectedStatus = "All";
        selectedCustomer = string.Empty;
        ApplyFilters();
    }

    private async Task RefreshData()
    {
        await LoadData();
        ApplyFilters();
    }

    private async Task ExportToExcel()
    {
        if (OrderGrid != null)
        {
            await OrderGrid.ExportToExcelAsync();
        }
    }

    private void OpenCreateOrderDialog()
    {
        isEditMode = false;
        currentOrder = new SalesOrder 
        { 
            OrderDate = DateTime.Now,
            Status = "Draft",
            Priority = "Medium"
        };
        showOrderDialog = true;
    }

    private void EditOrder(string orderId)
    {
        var order = orders.FirstOrDefault(o => o.OrderId == orderId);
        if (order != null)
        {
            isEditMode = true;
            currentOrder = order.Clone();
            showOrderDialog = true;
        }
    }

    private void ViewOrder(string orderId)
    {
        // Navigate to order details page
        // Navigation.NavigateTo($"/sales/orders/{orderId}");
    }

    private async Task DeleteOrder(string orderId)
    {
        // Show confirmation dialog and delete order
        orders.RemoveAll(o => o.OrderId == orderId);
        ApplyFilters();
        await Task.CompletedTask;
    }

    private void SaveOrder()
    {
        if (isEditMode)
        {
            var existingOrder = orders.FirstOrDefault(o => o.OrderId == currentOrder.OrderId);
            if (existingOrder != null)
            {
                var index = orders.IndexOf(existingOrder);
                orders[index] = currentOrder.Clone();
            }
        }
        else
        {
            currentOrder.OrderId = $"SO-{DateTime.Now.Year}-{orders.Count + 1:D4}";
            orders.Add(currentOrder.Clone());
        }
        
        ApplyFilters();
        showOrderDialog = false;
    }

    private void CancelOrder()
    {
        showOrderDialog = false;
    }

    // Data Models
    public class SalesOrder
    {
        public string OrderId { get; set; } = string.Empty;
        public string CustomerName { get; set; } = string.Empty;
        public DateTime OrderDate { get; set; }
        public decimal TotalAmount { get; set; }
        public string Status { get; set; } = string.Empty;
        public string SalesRepName { get; set; } = string.Empty;
        public DateTime? DeliveryDate { get; set; }
        public string Priority { get; set; } = string.Empty;
        public string Notes { get; set; } = string.Empty;

        public SalesOrder Clone()
        {
            return new SalesOrder
            {
                OrderId = this.OrderId,
                CustomerName = this.CustomerName,
                OrderDate = this.OrderDate,
                TotalAmount = this.TotalAmount,
                Status = this.Status,
                SalesRepName = this.SalesRepName,
                DeliveryDate = this.DeliveryDate,
                Priority = this.Priority,
                Notes = this.Notes
            };
        }
    }

    public class StatusOption
    {
        public string Value { get; set; } = string.Empty;
        public string Text { get; set; } = string.Empty;
    }

    public class PriorityOption
    {
        public string Value { get; set; } = string.Empty;
        public string Text { get; set; } = string.Empty;
    }
}

<style>
    .sales-container {
        padding: 24px;
        background: var(--bg-secondary);
        min-height: calc(100vh - 64px);
        width: 100%;
        max-width: none;
        margin: 0;
        box-sizing: border-box;
    }

    .sales-header {
        margin-bottom: 32px;
        padding: 24px;
        background: var(--bg-primary);
        border-radius: 16px;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--border-color);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 20px;
    }

    .page-title {
        font-size: 32px;
        font-weight: 800;
        color: var(--text-primary);
        margin: 0;
        background: var(--gradient-primary);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
    }

    .header-actions {
        display: flex;
        gap: 12px;
        align-items: center;
    }

    .filter-card {
        margin-bottom: 24px;
        background: var(--bg-primary);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        box-shadow: var(--shadow-sm);
    }

    .filter-row {
        display: flex;
        gap: 24px;
        align-items: end;
        flex-wrap: wrap;
        padding: 24px;
    }

    .filter-item {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .filter-item label {
        font-size: 14px;
        font-weight: 600;
        color: var(--text-secondary);
    }

    .grid-card {
        background: var(--bg-primary);
        border: 1px solid var(--border-color);
        border-radius: 16px;
        box-shadow: var(--shadow-sm);
        overflow: hidden;
    }

    .order-link {
        color: var(--primary-color);
        text-decoration: none;
        font-weight: 600;
        transition: all 0.2s ease;
    }

    .order-link:hover {
        color: var(--primary-light);
        text-decoration: underline;
    }

    .status-badge {
        padding: 6px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        display: inline-flex;
        align-items: center;
        gap: 4px;
        border: 1px solid transparent;
    }

    .status-badge.draft {
        background: rgba(156, 163, 175, 0.2);
        color: #9ca3af;
    }

    .status-badge.pending {
        background: rgba(245, 158, 11, 0.2);
        color: #f59e0b;
    }

    .status-badge.processing {
        background: rgba(59, 130, 246, 0.2);
        color: #3b82f6;
    }

    .status-badge.shipped {
        background: rgba(139, 92, 246, 0.2);
        color: #8b5cf6;
    }

    .status-badge.delivered {
        background: rgba(16, 185, 129, 0.2);
        color: #10b981;
    }

    .status-badge.cancelled {
        background: rgba(239, 68, 68, 0.2);
        color: #ef4444;
    }

    .priority-badge {
        padding: 4px 8px;
        border-radius: 12px;
        font-size: 11px;
        font-weight: 600;
        text-transform: uppercase;
    }

    .priority-badge.low {
        background: rgba(16, 185, 129, 0.2);
        color: #10b981;
    }

    .priority-badge.medium {
        background: rgba(59, 130, 246, 0.2);
        color: #3b82f6;
    }

    .priority-badge.high {
        background: rgba(245, 158, 11, 0.2);
        color: #f59e0b;
    }

    .priority-badge.urgent {
        background: rgba(239, 68, 68, 0.2);
        color: #ef4444;
    }

    .action-buttons {
        display: flex;
        gap: 4px;
    }

    .order-form {
        padding: 20px 0;
    }

    .form-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 20px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .form-group label {
        font-size: 14px;
        font-weight: 600;
        color: var(--text-light);
    }

    /* Responsive adjustments */
    @@media (max-width: 768px) {
        .sales-container {
            padding: 16px;
        }
        
        .sales-header {
            flex-direction: column;
            align-items: stretch;
        }
        
        .header-actions {
            justify-content: center;
        }
        
        .filter-row {
            flex-direction: column;
            align-items: stretch;
        }
        
        .form-row {
            grid-template-columns: 1fr;
        }
    }
</style>