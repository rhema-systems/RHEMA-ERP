@page "/loginsuccess"
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using ErpSystem.Core.Entities
@using System.Security.Claims

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject SignInManager<ApplicationUser> SignInManager
@inject ILogger<LoginSuccess> Logger
@inject IHttpContextAccessor HttpContextAccessor

<h3>Login Success Test Page</h3>

<div style="margin: 20px 0; padding: 20px; border: 2px solid blue; background: lightblue;">
    <h4>🔍 Post-Login Authentication Check</h4>
    <p><strong>Page Loaded At:</strong> @DateTime.Now.ToString("HH:mm:ss.fff")</p>
</div>

<div style="margin: 20px 0; padding: 20px; border: 2px solid green; background: lightgreen;">
    <h4>🌐 HTTP Context Authentication</h4>
    <p><strong>HTTP Context Available:</strong> @httpContextAvailable</p>
    <p><strong>User Authenticated (HTTP):</strong> @isAuthenticatedHTTP</p>
    <p><strong>User Name (HTTP):</strong> @userNameHTTP</p>
    <p><strong>HTTP Claims Count:</strong> @httpClaimsCount</p>
</div>

<div style="margin: 20px 0; padding: 20px; border: 2px solid orange; background: lightyellow;">
    <h4>📱 Blazor Authentication State</h4>
    <p><strong>User Authenticated (Blazor):</strong> @isAuthenticatedBlazor</p>
    <p><strong>User Name (Blazor):</strong> @userNameBlazor</p>
    <p><strong>Blazor Claims Count:</strong> @blazorClaimsCount</p>
</div>

<div style="margin: 20px 0; padding: 20px; border: 2px solid purple; background: plum;">
    <h4>🔑 SignInManager Check</h4>
    <p><strong>SignInManager Available:</strong> @(SignInManager != null)</p>
    <p><strong>Current Context User:</strong> @signInManagerUser</p>
</div>

<AuthorizeView>
    <Authorized>
        <div style="margin: 20px 0; padding: 20px; border: 2px solid green; background: lightgreen;">
            <h4>✅ AuthorizeView: AUTHENTICATED</h4>
            <p><strong>User:</strong> @context.User?.Identity?.Name</p>
        </div>
    </Authorized>
    <NotAuthorized>
        <div style="margin: 20px 0; padding: 20px; border: 2px solid red; background: pink;">
            <h4>❌ AuthorizeView: NOT AUTHENTICATED</h4>
        </div>
    </NotAuthorized>
</AuthorizeView>

<button class="btn btn-primary" @onclick="RefreshData">🔄 Refresh Data</button>

@code {
    private bool httpContextAvailable = false;
    private bool isAuthenticatedHTTP = false;
    private string userNameHTTP = "";
    private int httpClaimsCount = 0;
    
    private bool isAuthenticatedBlazor = false;
    private string userNameBlazor = "";
    private int blazorClaimsCount = 0;
    
    private string signInManagerUser = "";

    protected override async Task OnInitializedAsync()
    {
        Logger.LogInformation("=== LOGIN SUCCESS PAGE LOADED ===");
        await RefreshData();
    }

    private async Task RefreshData()
    {
        Logger.LogInformation("=== REFRESHING LOGIN SUCCESS DATA ===");
        
        try
        {
            // Check HTTP Context
            var httpContext = HttpContextAccessor.HttpContext;
            httpContextAvailable = httpContext != null;
            if (httpContext?.User != null)
            {
                isAuthenticatedHTTP = httpContext.User.Identity?.IsAuthenticated ?? false;
                userNameHTTP = httpContext.User.Identity?.Name ?? "NULL";
                httpClaimsCount = httpContext.User.Claims?.Count() ?? 0;
                
                Logger.LogInformation("HTTP Context - Authenticated: {Auth}, Name: {Name}, Claims: {Claims}", 
                    isAuthenticatedHTTP, userNameHTTP, httpClaimsCount);
            }

            // Check Blazor AuthenticationStateProvider
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            isAuthenticatedBlazor = authState?.User?.Identity?.IsAuthenticated ?? false;
            userNameBlazor = authState?.User?.Identity?.Name ?? "NULL";
            blazorClaimsCount = authState?.User?.Claims?.Count() ?? 0;
            
            Logger.LogInformation("Blazor AuthState - Authenticated: {Auth}, Name: {Name}, Claims: {Claims}", 
                isAuthenticatedBlazor, userNameBlazor, blazorClaimsCount);

            // Check SignInManager context
            if (httpContext != null)
            {
                signInManagerUser = httpContext.User?.Identity?.Name ?? "NULL";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error refreshing login success data");
        }
        
        StateHasChanged();
    }
}