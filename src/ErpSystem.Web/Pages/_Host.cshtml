@page "/"
@using Microsoft.AspNetCore.Components.Web
@namespace ErpSystem.Web.Pages
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="~/" />
    <title>ErpSystem - Enterprise Resource Planning</title>
    
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    
    <!-- Syncfusion Blazor Material 3 Theme -->
    <link href="_content/Syncfusion.Blazor.Themes/material3.css" rel="stylesheet" />
    
    <!-- Bootstrap and Custom CSS -->
    <link rel="stylesheet" href="css/bootstrap/bootstrap.min.css" />
    <link href="css/open-iconic/font/css/open-iconic-bootstrap.min.css" rel="stylesheet" />
    <link href="css/site.css" rel="stylesheet" />
    <link href="ErpSystem.Web.styles.css" rel="stylesheet" />
    <link rel="icon" type="image/png" href="favicon.png"/>
    
    <!-- Font Awesome for better icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    
    <style>
        :root {
            /* Modern Color Palette */
            --primary-color: #4f46e5;
            --primary-light: #6366f1;
            --primary-dark: #3730a3;
            --secondary-color: #06b6d4;
            --accent-color: #10b981;
            --warning-color: #f59e0b;
            --danger-color: #ef4444;
            
            /* Light Theme Colors */
            --bg-primary: #ffffff;
            --bg-secondary: #f8fafc;
            --bg-tertiary: #f1f5f9;
            --sidebar-bg: #ffffff;
            --card-bg: #ffffff;
            
            /* Text Colors */
            --text-primary: #1e293b;
            --text-secondary: #64748b;
            --text-muted: #94a3b8;
            --text-light: #ffffff;
            
            /* Border & Shadow */
            --border-color: #e2e8f0;
            --border-light: #f1f5f9;
            --shadow-sm: 0 1px 2px 0 rgba(0, 0, 0, 0.05);
            --shadow-md: 0 4px 6px -1px rgba(0, 0, 0, 0.1), 0 2px 4px -1px rgba(0, 0, 0, 0.06);
            --shadow-lg: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
            --shadow-xl: 0 20px 25px -5px rgba(0, 0, 0, 0.1), 0 10px 10px -5px rgba(0, 0, 0, 0.04);
            
            /* Gradients */
            --gradient-primary: linear-gradient(135deg, var(--primary-color) 0%, var(--primary-light) 100%);
            --gradient-secondary: linear-gradient(135deg, var(--secondary-color) 0%, var(--accent-color) 100%);
            --gradient-bg: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            
            /* Hover States */
            --hover-bg: rgba(79, 70, 229, 0.04);
            --hover-border: rgba(79, 70, 229, 0.2);
        }
        
        body {
            margin: 0;
            font-family: 'Inter', 'Segoe UI', -apple-system, BlinkMacSystemFont, 'Roboto', sans-serif;
            background: var(--bg-secondary);
            color: var(--text-primary);
            min-height: 100vh;
            line-height: 1.6;
            -webkit-font-smoothing: antialiased;
            -moz-osx-font-smoothing: grayscale;
        }
        
        .login-container {
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            background: var(--gradient-bg);
            position: relative;
            overflow: hidden;
        }
        
        .login-container::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1000 1000"><polygon fill="%23ffffff08" points="0,1000 1000,0 1000,1000"/></svg>');
            pointer-events: none !important;
            z-index: -1 !important;
        }
        
        .main-container {
            background: var(--bg-secondary);
            min-height: 100vh;
            color: var(--text-primary);
        }
        
        /* Force login card size override - ULTRA SPECIFIC */
        .login-container .login-card,
        div.login-container div.login-card,
        .login-card {
            max-width: 480px !important;
            min-width: 480px !important;
            width: 480px !important;
            position: relative !important;
            z-index: 10 !important;
        }
        
        /* Ensure form elements are interactive */
        .forgot-password-card {
            position: relative !important;
            z-index: 10 !important;
            pointer-events: auto !important;
        }
        
        .forgot-password-card input,
        .forgot-password-card select,
        .forgot-password-card button,
        .forgot-password-card a {
            pointer-events: auto !important;
            position: relative !important;
            z-index: 11 !important;
        }
        
        .page {
            position: relative !important;
            display: flex !important;
            flex-direction: row !important;
            min-height: 100vh !important;
            width: 100% !important;
        }
        
        .sidebar {
            background: var(--sidebar-bg) !important;
            width: 260px !important;
            min-width: 260px !important;
            max-width: 260px !important;
            flex: 0 0 260px !important;
            height: 100vh !important;
            z-index: 1000 !important;
            border-right: 1px solid var(--border-color) !important;
            overflow-y: auto !important;
            box-shadow: var(--shadow-lg) !important;
            display: flex !important;
            flex-direction: column !important;
            visibility: visible !important;
            opacity: 1 !important;
        }
        
        .top-row {
            background: var(--bg-primary);
            border-bottom: 1px solid var(--border-color);
            height: 64px;
            display: flex;
            align-items: center;
            padding: 0 24px;
            box-shadow: var(--shadow-sm);
            position: sticky;
            top: 0;
            z-index: 100;
        }
        
        .nav-content {
            display: flex;
            justify-content: space-between;
            align-items: center;
            width: 100%;
        }
        
        .nav-title h4 {
            margin: 0;
            color: var(--text-primary);
            font-weight: 700;
            font-size: 18px;
        }
        
        .user-info {
            display: flex;
            align-items: center;
            gap: 15px;
        }
        
        .user-name {
            color: var(--text-secondary);
            font-size: 14px;
            font-weight: 500;
        }
        
        main {
            flex: 1 1 auto !important;
            margin-left: 0 !important;
            display: flex !important;
            flex-direction: column !important;
            width: calc(100% - 260px) !important;
            min-width: calc(100% - 260px) !important;
            box-sizing: border-box !important;
            background: var(--bg-secondary) !important;
            height: 100vh !important;
        }
        
        .content {
            flex: 1;
            padding: 0;
            background: var(--bg-secondary);
            width: 100%;
            box-sizing: border-box;
        }
        
        /* Force sidebar visibility on desktop */
        .sidebar {
            transform: translateX(0) !important;
        }
        
        /* Ensure authorized layout shows properly */
        .page > .sidebar {
            display: flex !important;
            visibility: visible !important;
            opacity: 1 !important;
        }
        
        .page > main {
            display: flex !important;
            flex-direction: column !important;
        }
        
        /* Force sidebar to show in all states */
        div[class*="sidebar"] {
            display: flex !important;
            visibility: visible !important;
            opacity: 1 !important;
            transform: translateX(0) !important;
        }
        
        /* Force nav-menu visibility */
        .nav-menu,
        .nav-menu.collapsed {
            display: block !important;
            visibility: visible !important;
            opacity: 1 !important;
        }
        
        /* Ultra-aggressive NavMenu targeting */
        .sidebar .nav-menu,
        .sidebar .nav-menu.collapsed,
        .sidebar .nav-scrollable,
        .sidebar .nav-content {
            display: block !important;
            visibility: visible !important;
            opacity: 1 !important;
            height: auto !important;
        }
        
        .sidebar .nav-section {
            display: block !important;
            visibility: visible !important;
            opacity: 1 !important;
        }
        
        .sidebar .nav-item {
            display: block !important;
            visibility: visible !important;
            opacity: 1 !important;
        }
        
        /* Clean layout without debugging colors */
        
        /* Force the layout to work regardless */
        body {
            overflow-x: hidden !important;
        }
        
        .page {
            display: flex !important;
            flex-direction: row !important;
            width: 100vw !important;
            height: 100vh !important;
            position: fixed !important;
            top: 0 !important;
            left: 0 !important;
        }
        
        /* ULTRA AGGRESSIVE DEBUGGING STYLES */
        .sidebar {
            background: red !important;
            position: fixed !important;
            left: 0 !important;
            top: 0 !important;
            width: 300px !important;
            height: 100vh !important;
            z-index: 9999 !important;
            display: block !important;
            visibility: visible !important;
            opacity: 1 !important;
        }
        
        main {
            margin-left: 300px !important;
            width: calc(100% - 300px) !important;
        }
        
        /* Responsive */
        @@media (max-width: 768px) {
            .sidebar {
                transform: translateX(-100%) !important;
                transition: transform 0.3s ease;
            }
            
            .sidebar.show {
                transform: translateX(0) !important;
            }
            
            main {
                margin-left: 0 !important;
                min-width: 100% !important;
            }
        }
        
        /* Modern Button Styles */
        .btn {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            padding: 10px 16px;
            border-radius: 8px;
            font-weight: 600;
            font-size: 14px;
            line-height: 1.5;
            cursor: pointer;
            transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
            text-decoration: none;
            border: 1px solid transparent;
        }
        
        .btn-primary {
            background: var(--gradient-primary);
            color: white;
            border: none;
            box-shadow: var(--shadow-sm);
        }
        
        .btn-primary:hover {
            transform: translateY(-1px);
            box-shadow: var(--shadow-md);
            filter: brightness(1.05);
        }
        
        .btn-secondary {
            background: var(--bg-primary);
            color: var(--text-primary);
            border: 1px solid var(--border-color);
            box-shadow: var(--shadow-sm);
        }
        
        .btn-secondary:hover {
            background: var(--bg-tertiary);
            border-color: var(--hover-border);
            transform: translateY(-1px);
        }
        
        .btn-outline {
            background: transparent;
            border: 1px solid var(--border-color);
            color: var(--text-secondary);
        }
        
        .btn-outline:hover {
            background: var(--hover-bg);
            border-color: var(--hover-border);
            color: var(--primary-color);
        }
        
        /* Syncfusion Component Theme Customization */
        .e-card {
            border-radius: 16px !important;
            box-shadow: var(--shadow-sm) !important;
            border: 1px solid var(--border-color) !important;
        }
        
        .e-card .e-card-header {
            background: var(--bg-tertiary) !important;
            border-bottom: 1px solid var(--border-color) !important;
            color: var(--text-primary) !important;
            font-weight: 600 !important;
        }
        
        .e-btn.e-primary {
            background: var(--gradient-primary) !important;
            border: none !important;
            border-radius: 8px !important;
        }
        
        .e-btn.e-primary:hover {
            filter: brightness(1.05) !important;
            transform: translateY(-1px) !important;
        }
        
        .e-grid {
            border-radius: 8px !important;
            overflow: hidden !important;
        }
        
        .e-grid .e-gridheader {
            background: var(--bg-tertiary) !important;
            color: var(--text-primary) !important;
            font-weight: 600 !important;
        }
        
        .e-input-group {
            border-radius: 8px !important;
            border-color: var(--border-color) !important;
        }
        
        .e-input-group:focus-within {
            border-color: var(--primary-color) !important;
            box-shadow: 0 0 0 2px rgba(79, 70, 229, 0.1) !important;
        }
        
        .e-dialog {
            border-radius: 16px !important;
            box-shadow: var(--shadow-xl) !important;
        }
    </style>
    
    <component type="typeof(HeadOutlet)" render-mode="Server" />
</head>
<body>
    <component type="typeof(App)" render-mode="Server" />

    <div id="blazor-error-ui">
        <environment include="Staging,Production">
            An error has occurred. This application may no longer respond until reloaded.
        </environment>
        <environment include="Development">
            An unhandled exception has occurred. See browser dev tools for details.
        </environment>
        <a href="" class="reload">Reload</a>
        <a class="dismiss">🗙</a>
    </div>

    <script src="_framework/blazor.server.js"></script>
</body>
</html>
