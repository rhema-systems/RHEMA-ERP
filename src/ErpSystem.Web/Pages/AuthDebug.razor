@page "/authdebug"
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Identity
@using ErpSystem.Core.Entities
@using System.Security.Claims

@inject AuthenticationStateProvider AuthenticationStateProvider
@inject SignInManager<ApplicationUser> SignInManager
@inject ILogger<AuthDebug> Logger
@inject IHttpContextAccessor HttpContextAccessor

<h3>Authentication Debug Information</h3>

<div style="margin: 20px 0; padding: 20px; border: 2px solid blue; background: lightblue;">
    <h4>🔍 Authentication State Provider Check</h4>
    <p><strong>Auth State Provider Type:</strong> @(AuthenticationStateProvider.GetType().Name)</p>
    <p><strong>User Authenticated (ASP):</strong> @isAuthenticatedASP</p>
    <p><strong>User Name (ASP):</strong> @userNameASP</p>
    <p><strong>User Claims Count (ASP):</strong> @claimsCountASP</p>
</div>

<div style="margin: 20px 0; padding: 20px; border: 2px solid green; background: lightgreen;">
    <h4>🌐 HTTP Context Check</h4>
    <p><strong>HTTP Context Available:</strong> @httpContextAvailable</p>
    <p><strong>User Authenticated (HTTP):</strong> @isAuthenticatedHTTP</p>
    <p><strong>User Name (HTTP):</strong> @userNameHTTP</p>
    <p><strong>User Claims Count (HTTP):</strong> @claimsCountHTTP</p>
</div>

<div style="margin: 20px 0; padding: 20px; border: 2px solid orange; background: lightyellow;">
    <h4>📝 All Claims</h4>
    @if (allClaims.Any())
    {
        <ul>
            @foreach (var claim in allClaims)
            {
                <li><strong>@claim.Type:</strong> @claim.Value</li>
            }
        </ul>
    }
    else
    {
        <p>No claims found</p>
    }
</div>

<button class="btn btn-primary" @onclick="RefreshState">🔄 Refresh State</button>

@code {
    private bool isAuthenticatedASP = false;
    private string userNameASP = "";
    private int claimsCountASP = 0;
    
    private bool httpContextAvailable = false;
    private bool isAuthenticatedHTTP = false;
    private string userNameHTTP = "";
    private int claimsCountHTTP = 0;
    
    private List<Claim> allClaims = new();

    protected override async Task OnInitializedAsync()
    {
        await RefreshState();
    }

    private async Task RefreshState()
    {
        Logger.LogInformation("=== AUTH DEBUG PAGE REFRESH ===");
        
        try
        {
            // Check AuthenticationStateProvider
            var authState = await AuthenticationStateProvider.GetAuthenticationStateAsync();
            isAuthenticatedASP = authState?.User?.Identity?.IsAuthenticated ?? false;
            userNameASP = authState?.User?.Identity?.Name ?? "NULL";
            claimsCountASP = authState?.User?.Claims?.Count() ?? 0;
            allClaims = authState?.User?.Claims?.ToList() ?? new();
            
            Logger.LogInformation("AuthStateProvider - Authenticated: {Auth}, Name: {Name}, Claims: {Claims}", 
                isAuthenticatedASP, userNameASP, claimsCountASP);

            // Check HTTP Context
            var httpContext = HttpContextAccessor.HttpContext;
            httpContextAvailable = httpContext != null;
            if (httpContext?.User != null)
            {
                isAuthenticatedHTTP = httpContext.User.Identity?.IsAuthenticated ?? false;
                userNameHTTP = httpContext.User.Identity?.Name ?? "NULL";
                claimsCountHTTP = httpContext.User.Claims?.Count() ?? 0;
                
                Logger.LogInformation("HttpContext - Authenticated: {Auth}, Name: {Name}, Claims: {Claims}", 
                    isAuthenticatedHTTP, userNameHTTP, claimsCountHTTP);
                    
                // Merge claims if HTTP context has different ones
                if (httpContext.User.Claims != null)
                {
                    var httpClaims = httpContext.User.Claims.ToList();
                    allClaims.AddRange(httpClaims.Where(hc => !allClaims.Any(ac => ac.Type == hc.Type && ac.Value == hc.Value)));
                }
            }
            
            Logger.LogInformation("Total claims found: {Count}", allClaims.Count);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error refreshing auth state");
        }
        
        StateHasChanged();
    }
}