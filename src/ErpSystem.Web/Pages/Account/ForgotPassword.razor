@page "/Account/ForgotPassword"
@using Microsoft.AspNetCore.Identity
@using ErpSystem.Core.Entities
@using ErpSystem.Core.Services
@using ErpSystem.Shared
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Notifications

@inject ITenantService TenantService
@inject IJSRuntime JSRuntime
@inject ILogger<ForgotPassword> Logger
@inject NavigationManager Navigation

<PageTitle>Forgot Password - ErpSystem</PageTitle>

<div class="forgot-password-container">
    <div class="forgot-password-card">
        <div class="forgot-password-header">
            <div class="logo-container">
                <div class="logo-icon">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 2L2 7V17L12 22L22 17V7L12 2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="currentColor" opacity="0.3"/>
                        <path d="M12 22V12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M22 17L12 12L2 17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M22 7L12 12L2 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>
            </div>
            <h2 class="forgot-password-title">Forgot Password</h2>
            <p class="forgot-password-subtitle">Enter your email address and we'll send you instructions to reset your password.</p>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger" role="alert">
                @errorMessage
            </div>
        }

        @if (!string.IsNullOrEmpty(successMessage))
        {
            <div class="alert alert-success" role="alert">
                @successMessage
            </div>
        }

        @if (string.IsNullOrEmpty(successMessage))
        {
            <form @onsubmit="HandleSubmit" @onsubmit:preventDefault="true">
                <div class="form-group">
                    <label class="form-label">TENANT</label>
                    <select @bind="selectedTenantCode" class="form-control tenant-dropdown" required>
                        <option value="">Select tenant...</option>
                        @foreach (var tenant in tenants)
                        {
                            <option value="@tenant.Code">@tenant.Name</option>
                        }
                    </select>
                </div>

                <div class="form-group">
                    <label class="form-label">Email Address</label>
                    <input @bind="email" type="email" class="form-control forgot-password-input" placeholder="Enter your email address" required />
                </div>

                <div class="form-group">
                    <button type="submit" class="btn btn-primary forgot-password-btn w-100" disabled="@isLoading">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status"></span>
                            <text>Sending Instructions...</text>
                        }
                        else
                        {
                            <text>Send Reset Instructions</text>
                        }
                    </button>
                </div>

                <div class="form-group text-center">
                    <button type="button" class="back-to-login-link" @onclick="GoBackToLogin">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg" class="me-1">
                            <path d="M19 12H5m0 0l7 7m-7-7 7-7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        Back to Login
                    </button>
                </div>
            </form>
        }
        else
        {
            <div class="text-center">
                <a href="/Account/Login" class="btn btn-outline-primary">Return to Login</a>
            </div>
        }
    </div>
</div>

@code {
    private List<Tenant> tenants = new();
    private string selectedTenantCode = string.Empty;
    private string email = string.Empty;
    private string errorMessage = string.Empty;
    private string successMessage = string.Empty;
    private bool isLoading = false;

    protected override async Task OnInitializedAsync()
    {
        await LoadTenantsAsync();
        
        // Set default tenant if only one exists
        if (tenants.Count == 1)
        {
            selectedTenantCode = tenants.First().Code;
        }
    }

    private async Task LoadTenantsAsync()
    {
        try
        {
            var allTenants = await TenantService.GetAllTenantsAsync();
            tenants = allTenants.Where(t => t.Status == TenantStatus.Active).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading tenants");
            errorMessage = "An error occurred loading tenant information. Please refresh the page.";
        }
    }

    private async Task HandleSubmit()
    {
        errorMessage = string.Empty;
        successMessage = string.Empty;
        
        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(selectedTenantCode))
        {
            errorMessage = "Please provide both email address and tenant selection.";
            return;
        }

        isLoading = true;
        StateHasChanged();

        try
        {
            var formData = new FormUrlEncodedContent(new[]
            {
                new KeyValuePair<string, string>("Email", email),
                new KeyValuePair<string, string>("TenantCode", selectedTenantCode)
            });

            using var httpClient = new HttpClient();
            var response = await httpClient.PostAsync($"{await GetBaseUrlAsync()}/api/Account/ForgotPassword", formData);
            
            if (response.IsSuccessStatusCode)
            {
                successMessage = "If your email exists in our system, you will receive password reset instructions. Please check your email.";
                Logger.LogInformation("Password reset request submitted for {Email} on tenant {TenantCode}", email, selectedTenantCode);
            }
            else
            {
                var errorContent = await response.Content.ReadAsStringAsync();
                errorMessage = "An error occurred processing your request. Please try again.";
                Logger.LogWarning("Password reset request failed for {Email}: {Error}", email, errorContent);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error submitting password reset request for {Email}", email);
            errorMessage = "An error occurred processing your request. Please try again.";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }

    private async Task<string> GetBaseUrlAsync()
    {
        var baseUrl = await JSRuntime.InvokeAsync<string>("eval", "window.location.origin");
        return baseUrl;
    }
    
    private void GoBackToLogin()
    {
        Navigation.NavigateTo("/Account/Login");
    }
}

<style>
    .forgot-password-container {
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
        padding: 20px;
    }

    .forgot-password-card {
        background: white;
        border-radius: 12px;
        padding: 40px;
        width: 100%;
        max-width: 450px;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
    }

    .forgot-password-header {
        text-align: center;
        margin-bottom: 30px;
    }

    .logo-container {
        margin-bottom: 20px;
    }

    .logo-icon {
        color: #667eea;
        display: inline-block;
    }

    .forgot-password-title {
        margin: 0 0 10px 0;
        font-size: 2rem;
        font-weight: 600;
        color: #333;
    }

    .forgot-password-subtitle {
        margin: 0 0 20px 0;
        color: #666;
        font-size: 14px;
        line-height: 1.5;
    }

    .form-group {
        margin-bottom: 24px;
    }

    .form-label {
        display: block;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        color: #666;
        margin-bottom: 8px;
    }

    .tenant-dropdown,
    .forgot-password-input {
        width: 100%;
        padding: 12px;
        border: 2px solid #e1e5e9;
        border-radius: 6px;
        font-size: 14px;
        transition: border-color 0.15s ease-in-out;
    }

    .tenant-dropdown:focus,
    .forgot-password-input:focus {
        outline: none;
        border-color: #667eea;
        box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
    }

    .forgot-password-btn {
        width: 100%;
        height: 48px;
        font-size: 16px;
        font-weight: 600;
        background: #667eea;
        border: none;
        border-radius: 6px;
        transition: all 0.15s ease-in-out;
    }

    .forgot-password-btn:hover:not(:disabled) {
        background: #5a6fd8;
        transform: translateY(-1px);
    }

    .forgot-password-btn:disabled {
        opacity: 0.7;
        cursor: not-allowed;
    }

    .back-to-login-link {
        color: #667eea !important;
        text-decoration: none !important;
        font-size: 14px !important;
        display: inline-flex !important;
        align-items: center !important;
        transition: all 0.15s ease-in-out !important;
        background: transparent !important;
        border: 1px solid #667eea !important;
        padding: 8px 16px !important;
        border-radius: 6px !important;
        cursor: pointer !important;
        pointer-events: auto !important;
    }

    .back-to-login-link:hover {
        color: white;
        background: #667eea;
        text-decoration: none;
    }

    .alert {
        padding: 12px 16px;
        border-radius: 6px;
        margin-bottom: 20px;
        border: 1px solid transparent;
    }

    .alert-danger {
        color: #721c24;
        background-color: #f8d7da;
        border-color: #f5c6cb;
    }

    .alert-success {
        color: #155724;
        background-color: #d4edda;
        border-color: #c3e6cb;
    }

    .spinner-border-sm {
        width: 1rem;
        height: 1rem;
        border-width: 0.1rem;
    }

    .spinner-border {
        display: inline-block;
        vertical-align: text-bottom;
        border: 0.25em solid currentColor;
        border-right-color: transparent;
        border-radius: 50%;
        animation: spinner-border 0.75s linear infinite;
    }

    @@keyframes spinner-border {
        to { transform: rotate(360deg); }
    }
</style>