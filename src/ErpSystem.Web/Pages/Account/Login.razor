@page "/Account/Login"
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Identity
@using ErpSystem.Core.Entities
@using ErpSystem.Core.Services
@using ErpSystem.Shared
@using Syncfusion.Blazor.DropDowns
@using Syncfusion.Blazor.Inputs
@using Syncfusion.Blazor.Buttons
@using Syncfusion.Blazor.Notifications

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject ITenantService TenantService
@inject ILdapAuthenticationService LdapService
@inject NavigationManager Navigation
@inject ILogger<Login> Logger

<PageTitle>Login - ErpSystem</PageTitle>

<div class="login-container">
    <div class="login-card">
        <div class="login-header">
            <div class="logo-container">
                <div class="logo-icon">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <path d="M12 2L2 7V17L12 22L22 17V7L12 2Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" fill="currentColor" opacity="0.3"/>
                        <path d="M12 22V12" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M22 17L12 12L2 17" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                        <path d="M22 7L12 12L2 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                </div>
            </div>
            <h2 class="login-title">Login</h2>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger">
                @errorMessage
            </div>
        }
        
        <form @onsubmit="LoginUser" @onsubmit:preventDefault="true">
            <div class="form-group compact">
                <label class="form-label">TENANT</label>
                <select @bind="selectedTenantCode" class="form-control tenant-select" required>
                    <option value="">Not selected</option>
                    @foreach (var tenant in tenants)
                    {
                        <option value="@tenant.Code">@tenant.Name</option>
                    }
                </select>
                <div class="tenant-switch">
                    <button type="button" class="switch-btn">switch</button>
                </div>
            </div>

            <div class="register-link-container">
                <span>Not a member yet? <a href="/Account/Register" class="register-link">Register</a></span>
            </div>

            <div class="form-group compact">
                <label class="form-label">User name or email address</label>
                <input @bind="loginModel.Username" type="text" class="form-control" placeholder="admin" />
                <div class="helper-text">Default username: admin</div>
            </div>

            <div class="form-group compact">
                <label class="form-label">Password</label>
                <input @bind="loginModel.Password" type="password" class="form-control" placeholder="••••••" />
                <div class="helper-text">Default password: Admin123!</div>
            </div>

            <div class="remember-forgot-row">
                <label class="remember-checkbox">
                    <input type="checkbox" @bind="loginModel.RememberMe" />
                    <span class="checkmark"></span>
                    Remember me
                </label>
                <a href="/Account/ForgotPassword" class="forgot-link">Forgot password?</a>
            </div>

            <button type="submit" class="login-btn" disabled="@isLoading">
                @if (isLoading)
                {
                    <span>Signing in...</span>
                }
                else
                {
                    <span>Login</span>
                }
            </button>
        </form>
    </div>
</div>

@code {
    private List<Tenant> tenants = new();
    private List<TenantOption> tenantOptions = new();
    private string selectedTenantCode = string.Empty;
    private LoginModel loginModel = new() { Username = "admin", Password = "Admin123!" };
    private string errorMessage = string.Empty;
    private bool isLoading = false;

    [Inject] private HttpClient Http { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        await LoadTenantsAsync();
        
        // Set default tenant if only one exists
        if (tenants.Count == 1)
        {
            selectedTenantCode = tenants.First().Code;
        }
        else if (tenants.Any(t => t.Code == "DEFAULT"))
        {
            selectedTenantCode = "DEFAULT";
        }
    }

    private async Task LoadTenantsAsync()
    {
        try
        {
            var allTenants = await TenantService.GetAllTenantsAsync();
            tenants = allTenants.Where(t => t.Status == TenantStatus.Active).ToList();
            
            // Convert to dropdown options
            tenantOptions = tenants.Select(t => new TenantOption 
            { 
                Code = t.Code, 
                Name = t.Name 
            }).ToList();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading tenants");
            errorMessage = "Failed to load tenants. Please refresh the page.";
        }
    }
    
    private async Task LoginUser()
    {
        errorMessage = string.Empty;
        
        // Client-side validation
        if (string.IsNullOrEmpty(selectedTenantCode))
        {
            errorMessage = "Please select a tenant.";
            return;
        }
        
        if (string.IsNullOrEmpty(loginModel.Username))
        {
            errorMessage = "Username is required.";
            return;
        }
        
        if (string.IsNullOrEmpty(loginModel.Password))
        {
            errorMessage = "Password is required.";
            return;
        }
        
        isLoading = true;
        StateHasChanged();
        
        try
        {
            Logger.LogInformation("=== LOGIN ATTEMPT START (Blazor) ===");
            Logger.LogInformation("Login attempt: Username={Username}, Tenant={Tenant}, RememberMe={RememberMe}", 
                loginModel.Username, selectedTenantCode, loginModel.RememberMe);
                
            // Create form data for POST submission
            var formContent = new FormUrlEncodedContent(new[]
            {
                new KeyValuePair<string, string>("TenantCode", selectedTenantCode),
                new KeyValuePair<string, string>("Username", loginModel.Username),
                new KeyValuePair<string, string>("Password", loginModel.Password),
                new KeyValuePair<string, string>("RememberMe", loginModel.RememberMe.ToString().ToLower())
            });
            
            var baseAddress = Navigation.BaseUri;
            var loginUrl = $"{baseAddress}api/Account/Login";
            Logger.LogInformation("Posting to login URL: {LoginUrl}", loginUrl);
            
            var response = await Http.PostAsync(loginUrl, formContent);
            Logger.LogInformation("Login response: StatusCode={StatusCode}", response.StatusCode);
            
            if (response.IsSuccessStatusCode)
            {
                Logger.LogInformation("Login successful! Redirecting to Dashboard...");
                // Login successful, redirect to dashboard
                Navigation.NavigateTo("/Dashboard", forceLoad: true);
            }
            else
            {
                // Get error message from response
                var errorContent = await response.Content.ReadAsStringAsync();
                Logger.LogError("Login failed: {StatusCode} - {Error}", response.StatusCode, errorContent);
                errorMessage = errorContent.Contains("Invalid credentials") ? 
                    "Invalid username or password." : 
                    "Login failed. Please try again.";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Login error");
            errorMessage = "An error occurred during login. Please try again.";
        }
        finally
        {
            isLoading = false;
            StateHasChanged();
        }
    }
    
    // Data models
    public class TenantOption
    {
        public string Code { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
    }
    
    public class LoginModel
    {
        public string Username { get; set; } = string.Empty;
        public string Password { get; set; } = string.Empty;
        public bool RememberMe { get; set; }
    }
}

