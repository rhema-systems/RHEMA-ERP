@using Microsoft.AspNetCore.Components.Authorization

<div class="sidebar-header">
    <div class="sidebar-brand">
        <i class="fas fa-building"></i>
        <span>ERP System</span>
    </div>
    <button title="Toggle navigation" class="sidebar-toggle" @onclick="ToggleNavMenu">
        <i class="fas fa-bars"></i>
    </button>
</div>

<div class="nav-menu @(collapseNavMenu ? "collapsed" : "")">
    <div class="nav-scrollable">
        <nav class="nav-content">
        <AuthorizeView>
            <Authorized>
                <!-- Dashboard -->
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Dashboard" Match="NavLinkMatch.All">
                        <span class="oi oi-dashboard" aria-hidden="true"></span> Dashboard
                    </NavLink>
                </div>
                
                <!-- Sales Module -->
                <div class="nav-section">
                    <div class="nav-section-header" @onclick="() => ToggleSection(0)">
                        <span class="nav-section-title">Sales</span>
                        <span class="nav-section-arrow @(collapsedSections[0] ? "oi oi-chevron-right" : "oi oi-chevron-bottom")"></span>
                    </div>
                    <div class="nav-section-content @(collapsedSections[0] ? "collapsed" : "expanded")">
                        <div class="nav-item px-4">
                            <NavLink class="nav-link" href="sales/customers">
                                <span class="oi oi-people" aria-hidden="true"></span> Customers
                            </NavLink>
                        </div>
                        <div class="nav-item px-4">
                            <NavLink class="nav-link" href="sales/orders">
                                <span class="oi oi-cart" aria-hidden="true"></span> Orders
                            </NavLink>
                        </div>
                        <div class="nav-item px-4">
                            <NavLink class="nav-link" href="sales/quotes">
                                <span class="oi oi-document" aria-hidden="true"></span> Quotes
                            </NavLink>
                        </div>
                    </div>
                </div>
                
                <!-- Inventory Module -->
                <div class="nav-section">
                    <div class="nav-section-header" @onclick="() => ToggleSection(1)">
                        <span class="nav-section-title">Inventory</span>
                        <span class="nav-section-arrow @(collapsedSections[1] ? "oi oi-chevron-right" : "oi oi-chevron-bottom")"></span>
                    </div>
                    <div class="nav-section-content @(collapsedSections[1] ? "collapsed" : "expanded")">
                        <div class="nav-item px-4">
                            <NavLink class="nav-link" href="inventory/products">
                                <span class="oi oi-box" aria-hidden="true"></span> Products
                            </NavLink>
                        </div>
                        <div class="nav-item px-4">
                            <NavLink class="nav-link" href="inventory/stock">
                                <span class="oi oi-layers" aria-hidden="true"></span> Stock Management
                            </NavLink>
                        </div>
                        <div class="nav-item px-4">
                            <NavLink class="nav-link" href="inventory/warehouses">
                                <span class="oi oi-home" aria-hidden="true"></span> Warehouses
                            </NavLink>
                        </div>
                    </div>
                </div>
                
                <!-- Finance Module -->
                <div class="nav-section">
                    <div class="nav-section-header" @onclick="() => ToggleSection(2)">
                        <span class="nav-section-title">Finance</span>
                        <span class="nav-section-arrow @(collapsedSections[2] ? "oi oi-chevron-right" : "oi oi-chevron-bottom")"></span>
                    </div>
                    <div class="nav-section-content @(collapsedSections[2] ? "collapsed" : "expanded")">
                        <div class="nav-item px-4">
                            <NavLink class="nav-link" href="finance/accounts">
                                <span class="oi oi-credit-card" aria-hidden="true"></span> Accounts
                            </NavLink>
                        </div>
                        <div class="nav-item px-4">
                            <NavLink class="nav-link" href="finance/invoices">
                                <span class="oi oi-document" aria-hidden="true"></span> Invoices
                            </NavLink>
                        </div>
                        <div class="nav-item px-4">
                            <NavLink class="nav-link" href="finance/reports">
                                <span class="oi oi-bar-chart" aria-hidden="true"></span> Financial Reports
                            </NavLink>
                        </div>
                    </div>
                </div>
                
                <!-- HR Module -->
                <div class="nav-section">
                    <div class="nav-section-header" @onclick="() => ToggleSection(3)">
                        <span class="nav-section-title">Human Resources</span>
                        <span class="nav-section-arrow @(collapsedSections[3] ? "oi oi-chevron-right" : "oi oi-chevron-bottom")"></span>
                    </div>
                    <div class="nav-section-content @(collapsedSections[3] ? "collapsed" : "expanded")">
                        <div class="nav-item px-4">
                            <NavLink class="nav-link" href="hr/employees">
                                <span class="oi oi-person" aria-hidden="true"></span> Employees
                            </NavLink>
                        </div>
                        <div class="nav-item px-4">
                            <NavLink class="nav-link" href="hr/payroll">
                                <span class="oi oi-dollar" aria-hidden="true"></span> Payroll
                            </NavLink>
                        </div>
                        <div class="nav-item px-4">
                            <NavLink class="nav-link" href="hr/attendance">
                                <span class="oi oi-clock" aria-hidden="true"></span> Attendance
                            </NavLink>
                        </div>
                    </div>
                </div>
                
                <!-- Procurement Module -->
                <div class="nav-section">
                    <div class="nav-section-header" @onclick="() => ToggleSection(4)">
                        <span class="nav-section-title">Procurement</span>
                        <span class="nav-section-arrow @(collapsedSections[4] ? "oi oi-chevron-right" : "oi oi-chevron-bottom")"></span>
                    </div>
                    <div class="nav-section-content @(collapsedSections[4] ? "collapsed" : "expanded")">
                        <div class="nav-item px-4">
                            <NavLink class="nav-link" href="procurement/suppliers">
                                <span class="oi oi-briefcase" aria-hidden="true"></span> Suppliers
                            </NavLink>
                        </div>
                        <div class="nav-item px-4">
                            <NavLink class="nav-link" href="procurement/purchase-orders">
                                <span class="oi oi-clipboard" aria-hidden="true"></span> Purchase Orders
                            </NavLink>
                        </div>
                    </div>
                </div>
                
                <!-- Marketing Module -->
                <div class="nav-section">
                    <div class="nav-section-header" @onclick="() => ToggleSection(5)">
                        <span class="nav-section-title">Marketing</span>
                        <span class="nav-section-arrow @(collapsedSections[5] ? "oi oi-chevron-right" : "oi oi-chevron-bottom")"></span>
                    </div>
                    <div class="nav-section-content @(collapsedSections[5] ? "collapsed" : "expanded")">
                        <div class="nav-item px-4">
                            <NavLink class="nav-link" href="marketing/campaigns">
                                <span class="oi oi-megaphone" aria-hidden="true"></span> Campaigns
                            </NavLink>
                        </div>
                        <div class="nav-item px-4">
                            <NavLink class="nav-link" href="marketing/leads">
                                <span class="oi oi-target" aria-hidden="true"></span> Leads
                            </NavLink>
                        </div>
                    </div>
                </div>
                
                <!-- Administration -->
                <div class="nav-section">
                    <div class="nav-section-header" @onclick="() => ToggleSection(6)">
                        <span class="nav-section-title">Administration</span>
                        <span class="nav-section-arrow @(collapsedSections[6] ? "oi oi-chevron-right" : "oi oi-chevron-bottom")"></span>
                    </div>
                    <div class="nav-section-content @(collapsedSections[6] ? "collapsed" : "expanded")">
                        <div class="nav-item px-4">
                            <NavLink class="nav-link" href="admin/users">
                                <span class="oi oi-people" aria-hidden="true"></span> User Management
                            </NavLink>
                        </div>
                        <div class="nav-item px-4">
                            <NavLink class="nav-link" href="admin/tenants">
                                <span class="oi oi-globe" aria-hidden="true"></span> Tenant Management
                            </NavLink>
                        </div>
                        <div class="nav-item px-4">
                            <NavLink class="nav-link" href="admin/settings">
                                <span class="oi oi-cog" aria-hidden="true"></span> Settings
                            </NavLink>
                        </div>
                    </div>
                </div>
            </Authorized>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="Account/Login">
                        <span class="oi oi-account-login" aria-hidden="true"></span> Login
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
        </nav>
    </div>
</div>

@code {
    private bool collapseNavMenu = false;
    private bool[] collapsedSections = new bool[7]; // 7 sections total


    protected override void OnInitialized()
    {
        // Initialize all sections as collapsed except first one (Sales)
        for (int i = 0; i < collapsedSections.Length; i++)
        {
            collapsedSections[i] = i != 0; // First section (Sales) starts expanded
        }
    }

    private void ToggleNavMenu()
    {
        collapseNavMenu = !collapseNavMenu;
    }

    private void ToggleSection(int sectionIndex)
    {
        if (sectionIndex >= 0 && sectionIndex < collapsedSections.Length)
        {
            collapsedSections[sectionIndex] = !collapsedSections[sectionIndex];
            StateHasChanged();
        }
    }
}
