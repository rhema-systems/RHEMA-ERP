<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      Normal Debug and Release runtime builds use lightweight migration metadata
      so Roslyn does not parse every historical EF target model. The executable
      migration classes remain compiled and FastBuildMigrationMetadata preserves
      runtime discovery for MigrateAsync. EF authoring/tooling has its own focused
      path below, while an explicit -p:TdcFastEfBuild=false still requests the
      complete historical target-model compilation when it is genuinely needed.
    -->
    <TdcFastEfBuild Condition="'$(TdcFastEfBuild)' == '' and '$(Tdc0402FocusedEfBuild)' != 'true' and '$(TdcFocusedEfToolingBuild)' != 'true'">true</TdcFastEfBuild>
    <TdcFastEfBuild Condition="'$(TdcFastEfBuild)' == ''">false</TdcFastEfBuild>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="iText7" Version="8.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="9.0.9" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.9" />
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ErpSystem.Core/ErpSystem.Core.csproj" />
    <ProjectReference Include="../ErpSystem.Shared/ErpSystem.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude duplicate migration artifacts (same class name) -->
    <Compile Remove="Migrations\20260207050009_AddSystemExceptionLogs.cs" />
    <Compile Remove="Migrations\20260207050009_AddSystemExceptionLogs.Designer.cs" />
    <!--
      These recent Finance migrations intentionally keep discovery attributes on their executable
      classes so fast Debug builds can apply them without generated designers. Excluding the same
      designers in full builds prevents duplicate DbContext/Migration attributes while preserving
      the authoritative current model in ApplicationDbContextModelSnapshot.
    -->
    <Compile Remove="Migrations\20260802142906_AddCashBankTransactionReversals.Designer.cs" />
    <Compile Remove="Migrations\20260802153959_AddFinancePeriodCloseWorkspace.Designer.cs" />
    <Compile Remove="Migrations\20260802172927_AddFinanceCloseTemplatesAndManualTasks.Designer.cs" />
    <Compile Remove="Migrations\20260803075605_AddFinanceCloseEvidenceAndWaivers.Designer.cs" />
    <Compile Remove="Migrations\20260803084838_AddFinanceCloseAgingEscalations.Designer.cs" />
    <Compile Remove="Migrations\20260803110029_AddFinancePeriodReopenApprovals.Designer.cs" />
    <Compile Remove="Migrations\20260803132236_AddApPaymentEvidenceAndAuthorityControls.Designer.cs" />
    <Compile Remove="Migrations\20260803144941_AddWhtComplianceLifecycle.Designer.cs" />
    <Compile Remove="Migrations\20260803163336_AddCashierTillControlWorkspace.Designer.cs" />
    <Compile Remove="Migrations\20260803182450_AddBankDepositConfirmationControls.Designer.cs" />
    <Compile Remove="Migrations\20260803193523_AddControlledCashBankDocumentIssuance.Designer.cs" />
    <Compile Remove="Migrations\20260803213749_AddCrossCurrencyBankTransfers.Designer.cs" />
    <!-- This metadata is compiled only when historical designers are omitted. -->
    <Compile Remove="Migrations\FastBuildMigrationMetadata.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(TdcFastEfBuild)' == 'true'">
    <!--
      The accumulated EF designer history exceeds 700 MB of generated C#.
      Lightweight metadata keeps every migration discoverable by startup
      MigrateAsync without compiling generated target models.
      When a generated designer is added, add its migration attribute to
      FastBuildMigrationMetadata.cs before merging. Use an explicit
      TdcFastEfBuild=false only for a complete historical-model verification.
    -->
    <Compile Remove="Migrations\*.Designer.cs" />
    <!-- The model snapshot is needed by EF tooling, not by runtime migration
         discovery. Excluding it keeps normal runtime builds on the intended
         lightweight path; focused tooling and explicit full-history verification
         still compile it when required. -->
    <Compile Remove="Migrations\ApplicationDbContextModelSnapshot.cs" />
    <Compile Include="Migrations\FastBuildMigrationMetadata.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(Tdc0402FocusedEfBuild)' == 'true'">
    <!-- TDC-0402 source/model feedback without recompiling historical generated designers. -->
    <Compile Remove="Migrations\*.Designer.cs" />
    <Compile Include="Migrations\20260729084856_TDC0401FrameworkAgreements.Designer.cs" />
    <Compile Include="Migrations\20260729124416_TDC0402FrameworkCallOffs.Designer.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(TdcFocusedEfToolingBuild)' == 'true'">
    <!--
      EF migration tooling needs the current model snapshot, but it does not
      need to parse hundreds of megabytes of historical target models. The
      lightweight attributes retain migration discovery while the snapshot
      remains compiled for accurate model differencing. Set the property as an
      environment variable when running dotnet ef.
    -->
    <Compile Remove="Migrations\*.Designer.cs" />
    <Compile Include="Migrations\FastBuildMigrationMetadata.cs" />
    <!-- Include only the migration being removed when EF tooling needs its
         generated target model. This preserves focused tooling performance
         without compiling the complete historical designer set. -->
    <Compile Include="$(TdcEfToolingMigrationDesigner)"
             Condition="'$(TdcEfToolingMigrationDesigner)' != ''" />
  </ItemGroup>

  <Target Name="RejectEfToolingWithFastMigrationBuild"
          BeforeTargets="GetEFProjectMetadata"
          Condition="'$(TdcFastEfBuild)' == 'true' and '$(TdcAllowFastEfRuntimeMigrationCommands)' != 'true'">
    <Error Text="EF authoring tooling requires the complete migration target-model history. For an explicit runtime-only migration list or database update, set TdcAllowFastEfRuntimeMigrationCommands=true; never use that opt-in for migrations add or remove." />
  </Target>

</Project>
