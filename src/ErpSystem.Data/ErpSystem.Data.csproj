<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      Debug builds use lightweight migration metadata so routine solution
      builds do not parse every historical EF target model. Release and custom
      verification configurations retain the complete migration history.
      Pass -p:TdcFastEfBuild=false to request a full Debug migration build.
    -->
    <TdcFastEfBuild Condition="'$(TdcFastEfBuild)' == '' and '$(Configuration)' == 'Debug' and '$(Tdc0402FocusedEfBuild)' != 'true' and '$(TdcFocusedEfToolingBuild)' != 'true'">true</TdcFastEfBuild>
    <TdcFastEfBuild Condition="'$(TdcFastEfBuild)' == ''">false</TdcFastEfBuild>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EPPlus" Version="7.0.5" />
    <PackageReference Include="iText7" Version="8.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="9.0.9" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.9" />
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ErpSystem.Core/ErpSystem.Core.csproj" />
    <ProjectReference Include="../ErpSystem.Shared/ErpSystem.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude duplicate migration artifacts (same class name) -->
    <Compile Remove="Migrations\20260207050009_AddSystemExceptionLogs.cs" />
    <Compile Remove="Migrations\20260207050009_AddSystemExceptionLogs.Designer.cs" />
    <!-- This metadata is compiled only when historical designers are omitted. -->
    <Compile Remove="Migrations\FastBuildMigrationMetadata.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(TdcFastEfBuild)' == 'true'">
    <!--
      The accumulated EF designer history exceeds 350 MB of generated C#.
      Lightweight metadata keeps every migration discoverable by startup
      MigrateAsync without compiling generated target models.
      Release/verification builds continue to compile the complete history.
      When a generated designer is no longer retained here, add its migration
      attribute to FastBuildMigrationMetadata.cs before merging.
    -->
    <Compile Remove="Migrations\*.Designer.cs" />
    <!-- The model snapshot is needed by EF tooling, not by runtime migration
         discovery. Excluding it keeps normal Debug builds on the intended
         lightweight path; Release/full verification still compiles it. -->
    <Compile Remove="Migrations\ApplicationDbContextModelSnapshot.cs" />
    <Compile Include="Migrations\FastBuildMigrationMetadata.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(Tdc0402FocusedEfBuild)' == 'true'">
    <!-- TDC-0402 source/model feedback without recompiling historical generated designers. -->
    <Compile Remove="Migrations\*.Designer.cs" />
    <Compile Include="Migrations\20260729084856_TDC0401FrameworkAgreements.Designer.cs" />
    <Compile Include="Migrations\20260729124416_TDC0402FrameworkCallOffs.Designer.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(TdcFocusedEfToolingBuild)' == 'true'">
    <!--
      EF migration tooling needs the current model snapshot, but it does not
      need to parse hundreds of megabytes of historical target models. The
      lightweight attributes retain migration discovery while the snapshot
      remains compiled for accurate model differencing. Set the property as an
      environment variable when running dotnet ef.
    -->
    <Compile Remove="Migrations\*.Designer.cs" />
    <Compile Include="Migrations\FastBuildMigrationMetadata.cs" />
  </ItemGroup>

  <Target Name="RejectEfToolingWithFastMigrationBuild"
          BeforeTargets="GetEFProjectMetadata"
          Condition="'$(TdcFastEfBuild)' == 'true'">
    <Error Text="EF tooling requires the complete migration target-model history. Re-run the dotnet ef command with --configuration Release (or build Debug with -p:TdcFastEfBuild=false)." />
  </Target>

</Project>
