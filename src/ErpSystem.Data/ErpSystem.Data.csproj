<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="EPPlus" Version="7.0.5" />
    <PackageReference Include="iText7" Version="8.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="9.0.9" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.9" />
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ErpSystem.Core/ErpSystem.Core.csproj" />
    <ProjectReference Include="../ErpSystem.Shared/ErpSystem.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude duplicate migration artifacts (same class name) -->
    <Compile Remove="Migrations\20260207050009_AddSystemExceptionLogs.cs" />
    <Compile Remove="Migrations\20260207050009_AddSystemExceptionLogs.Designer.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(TdcFastEfBuild)' == 'true'">
    <!--
      The accumulated EF designer history is about 278 MB of generated C#.
      This opt-in design-time path keeps the current snapshot and latest
      migration metadata while avoiding historical designer recompilation.
      Normal production builds continue to compile the complete history.
    -->
    <Compile Remove="Migrations\*.Designer.cs" />
    <Compile Include="Migrations\20260725111657_AddProcurementSupplierOnboardingTokens.Designer.cs" />
    <Compile Include="Migrations\20260726101435_AddProcurementSupplierDueDiligence.Designer.cs" />
    <Compile Include="Migrations\20260726174311_AddProcurementSupplierAvlLifecycle.Designer.cs" />
    <Compile Include="Migrations\20260726224147_AddProcurementSupplierRiskAndConcentration.Designer.cs" />
    <Compile Include="Migrations\20260727005601_AddProcurementSupplierPerformanceScorecards.Designer.cs" />
    <Compile Include="Migrations\20260727101510_AddProcurementSupplierMasterChangeRollout.Designer.cs" />
    <Compile Include="Migrations\20260727113854_AddProcurementSupplierApplicantAccess.Designer.cs" />
  </ItemGroup>

</Project>
