<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.105.1" />
    <PackageReference Include="iText7" Version="8.0.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="9.0.9" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="9.0.9" />
    <PackageReference Include="System.ComponentModel.Annotations" Version="5.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../ErpSystem.Core/ErpSystem.Core.csproj" />
    <ProjectReference Include="../ErpSystem.Shared/ErpSystem.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!--
      The merged pre-baseline archive retains 607 exact historical migration
      identities for audit and recovery analysis, but it is intentionally not part
      of the compiled EF migration assembly. Only the true merged current-model
      baseline under Migrations is executable. Future migrations are scaffolded
      normally after that baseline.
    -->
    <Compile Remove="LegacyMigrationsArchive\**\*.cs" />
    <!--
      These migrations were merged after the disposable baseline cutover but
      carry older timestamps. Their original EF metadata remains excluded so
      they cannot execute before the baseline. The guarded implementation files
      are compiled for the post-baseline reconciliation migration, which replays
      any schema that the baseline did not actually contain.
    -->
    <Compile Remove="SupersededMigrationsArchive\**\*.cs" />
    <Compile Include="SupersededMigrationsArchive\PreBaselineLateMerges\*.cs"
             Exclude="SupersededMigrationsArchive\PreBaselineLateMerges\*.Designer.cs;SupersededMigrationsArchive\PreBaselineLateMerges\20260915093000_AddProcedureCaseOrganizationScope.cs" />
  </ItemGroup>

  <ItemGroup Condition="'$(TdcFastEfBuild)' == 'true'">
    <!--
      Focused contract builds create their database from the current EF model and
      do not apply the migration chain. Excluding generated target models on that
      explicit path avoids compiling roughly 250 MB of historical metadata on a
      hosted runner. The disposable baseline designer remains included so the
      migration-discovery contract can prove the active chain starts at the reset
      boundary. Normal application, migration-tooling and release builds retain
      the complete migration assembly.

      Do not use TdcFastEfBuild for `dotnet ef migrations` or runtime MigrateAsync
      verification because migration discovery attributes live in the generated
      designer files.
    -->
    <Compile Remove="Migrations\*.Designer.cs" />
    <Compile Remove="Migrations\ApplicationDbContextModelSnapshot.cs" />
    <Compile Include="Migrations\20260916132000_DisposableDevelopmentCurrentModelBaseline.Designer.cs" />
  </ItemGroup>

</Project>
